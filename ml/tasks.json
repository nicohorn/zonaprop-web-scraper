{
  "price": {
    "label": "A · Predicción de precio",
    "desc": "Limpieza con reglas de consistencia y duplicados validados, test agrupado fijo, CV de 5 folds en train para elegir hiperparámetros, baselines (mediana global, mediana USD/m² del barrio, Ridge), variantes de LightGBM seleccionables y evaluación única en test.",
    "params": {
      "operacion": {
        "type": "select",
        "options": [
          "venta",
          "alquiler"
        ],
        "default": "venta",
        "label": "Operación"
      },
      "currency": {
        "type": "select",
        "options": [
          "USD",
          "ARS",
          "convertir_a_USD"
        ],
        "default": "USD",
        "label": "Moneda (convertir usa el dólar MEP)"
      },
      "fx_mep": {
        "type": "number",
        "min": 1,
        "max": 100000,
        "default": 1450,
        "label": "Dólar MEP (ARS por USD)"
      },
      "tipo": {
        "type": "select",
        "options": [
          "todos",
          "departamento",
          "casa",
          "ph",
          "terreno",
          "local",
          "oficina",
          "cochera"
        ],
        "default": "departamento",
        "label": "Tipo"
      },
      "variante": {
        "type": "select",
        "options": [
          "v1",
          "v2_texto",
          "v2_texto_calle",
          "v2_ppm2",
          "v2_pesos",
          "v2_huber",
          "v2_l1",
          "v2_segmentos",
          "v3_ppm2_huber",
          "v3_ppm2_pesos",
          "v3_ppm2_huber_pesos",
          "v4_calle_norm",
          "v4_texto3",
          "v4_te",
          "v4_tfidf",
          "v4_iso",
          "v4_todo",
          "v4_todo_sin_iso"
        ],
        "default": "v3_ppm2_huber",
        "label": "Variante de LightGBM (v1 = iteración anterior, 13,7 %; ver ablación)"
      },
      "duplicados": {
        "type": "select",
        "options": [
          "v2_direccion_texto",
          "v1_huella"
        ],
        "default": "v2_direccion_texto",
        "label": "Regla de duplicados (v1 = sólo huella, ~30 % de precisión)"
      },
      "target": {
        "type": "select",
        "options": [
          "log_price"
        ],
        "default": "log_price",
        "label": "Objetivo (log del precio; métricas en USD)"
      },
      "split": {
        "type": "select",
        "options": [
          "agrupado",
          "temporal",
          "aleatorio"
        ],
        "default": "agrupado",
        "label": "Test fijo (agrupado = la misma propiedad nunca en train y test; temporal = los más nuevos; aleatorio = sólo para comparar)"
      },
      "test_size": {
        "type": "number",
        "min": 0.05,
        "max": 0.5,
        "step": 0.05,
        "default": 0.2,
        "label": "Proporción de test"
      },
      "seed": {
        "type": "number",
        "min": 0,
        "max": 999999,
        "step": 1,
        "default": 42,
        "label": "Semilla aleatoria"
      },
      "cv_folds": {
        "type": "number",
        "min": 3,
        "max": 10,
        "step": 1,
        "default": 5,
        "label": "Folds de validación cruzada (agrupados, sobre train)"
      },
      "tune": {
        "type": "bool",
        "default": true,
        "label": "Elegir hiperparámetros por CV (grilla de 12)"
      },
      "learning_rate": {
        "type": "number",
        "min": 0.005,
        "max": 0.5,
        "step": 0.005,
        "default": 0.05,
        "label": "Learning rate (si no se usa la grilla)"
      },
      "num_leaves": {
        "type": "number",
        "min": 4,
        "max": 512,
        "step": 1,
        "default": 63,
        "label": "Hojas (si no se usa la grilla)"
      },
      "trim_pct": {
        "type": "number",
        "min": 0,
        "max": 10,
        "step": 0.5,
        "default": 1,
        "label": "Recorte de USD/m² en train (percentil, calculado sólo con train)"
      },
      "excluir_pozo": {
        "type": "bool",
        "default": true,
        "label": "Excluir pozo / en construcción (precios parciales)"
      },
      "comparar_aleatorio": {
        "type": "bool",
        "default": true,
        "label": "Comparar con el protocolo anterior (split aleatorio con duplicados)"
      },
      "use_text": {
        "type": "bool",
        "default": false,
        "label": "Experimento: variables de texto TF-IDF + SVD (sin montos; no se guarda para predecir)"
      },
      "shap": {
        "type": "bool",
        "default": true,
        "label": "Calcular SHAP"
      },
      "referencia_v1": {
        "type": "bool",
        "default": true,
        "label": "Entrenar también v1 como referencia en el mismo test"
      }
    },
    "question": "¿Cuánto debería valer este aviso?",
    "use": "Para estimar precio justo / USD/m²."
  },
  "price_ablation": {
    "label": "A2 · Ablación de variantes del modelo de precio",
    "desc": "Compara todas las variantes de LightGBM (texto, calle, objetivo log USD/m², pesos, Huber/L1, segmentos) con CV de 5 folds agrupados SOLO sobre train; métricas globales y por segmento (baratos, caros, grandes, barrios débiles). No toca el test.",
    "params": {
      "variantes": {
        "type": "multi",
        "options": [
          "v1",
          "v2_texto",
          "v2_texto_calle",
          "v2_ppm2",
          "v2_pesos",
          "v2_huber",
          "v2_l1",
          "v2_segmentos",
          "v3_ppm2_huber",
          "v3_ppm2_pesos",
          "v3_ppm2_huber_pesos",
          "v4_calle_norm",
          "v4_texto3",
          "v4_te",
          "v4_tfidf",
          "v4_iso",
          "v4_todo",
          "v4_todo_sin_iso"
        ],
        "default": [
          "v1",
          "v2_texto",
          "v2_texto_calle",
          "v2_ppm2",
          "v2_pesos",
          "v2_huber",
          "v2_l1",
          "v2_segmentos",
          "v3_ppm2_huber",
          "v3_ppm2_pesos",
          "v3_ppm2_huber_pesos",
          "v4_calle_norm",
          "v4_texto3",
          "v4_te",
          "v4_tfidf",
          "v4_iso",
          "v4_todo",
          "v4_todo_sin_iso"
        ],
        "label": "Variantes a comparar"
      },
      "cv_folds": {
        "type": "number",
        "min": 3,
        "max": 10,
        "step": 1,
        "default": 5,
        "label": "Folds (agrupados)"
      },
      "seed": {
        "type": "number",
        "min": 0,
        "max": 999999,
        "step": 1,
        "default": 42,
        "label": "Semilla"
      }
    },
    "question": "¿Qué cambio del modelo de precio ayuda y en qué segmento?",
    "use": "Para justificar la variante elegida en A."
  },
  "anomaly": {
    "label": "B · Oportunidades / anomalías",
    "desc": "Residuos fuera de muestra (LightGBM, 5 folds) + IsolationForest sobre USD/m² relativo al barrio.",
    "params": {
      "operacion": {
        "type": "select",
        "options": [
          "venta",
          "alquiler"
        ],
        "default": "venta",
        "label": "Operación"
      },
      "tipo": {
        "type": "select",
        "options": [
          "todos",
          "departamento",
          "casa",
          "ph"
        ],
        "default": "departamento",
        "label": "Tipo"
      },
      "contamination": {
        "type": "number",
        "min": 0.001,
        "max": 0.3,
        "step": 0.005,
        "default": 0.03,
        "label": "Contaminación (IsolationForest)"
      },
      "umbral_barrio": {
        "type": "number",
        "min": 0.05,
        "max": 0.9,
        "step": 0.05,
        "default": 0.35,
        "label": "Umbral de error de datos (fracción de la mediana USD/m² del barrio)"
      },
      "min_barrio": {
        "type": "number",
        "min": 3,
        "max": 500,
        "step": 1,
        "default": 15,
        "label": "Mínimo de avisos por barrio"
      },
      "n_folds": {
        "type": "number",
        "min": 2,
        "max": 10,
        "step": 1,
        "default": 5,
        "label": "Folds para residuos"
      },
      "top_n": {
        "type": "number",
        "min": 10,
        "max": 1000,
        "step": 10,
        "default": 50,
        "label": "Cuántos mostrar"
      }
    },
    "question": "¿Qué avisos parecen baratos o raros?",
    "use": "Para encontrar posibles gangas y errores de datos."
  },
  "yields": {
    "label": "C · Renta vs. venta por barrio",
    "desc": "Mediana de alquiler/m² (convertido a USD) contra mediana de venta USD/m², rentabilidad bruta anual.",
    "params": {
      "fx_mep": {
        "type": "number",
        "min": 0,
        "max": 100000,
        "default": 0,
        "label": "Dólar MEP (ARS por USD; 0 = automático desde dolarapi.com, si falla 1450)"
      },
      "as_of": {
        "type": "date",
        "default": "",
        "label": "Fecha de corte (vacío = hoy; usa avisos vistos hasta esa fecha)"
      },
      "tipo": {
        "type": "select",
        "options": [
          "todos",
          "departamento",
          "casa",
          "ph"
        ],
        "default": "departamento",
        "label": "Tipo"
      },
      "include_expensas": {
        "type": "bool",
        "default": false,
        "label": "Restar expensas del alquiler"
      },
      "min_n": {
        "type": "number",
        "min": 3,
        "max": 500,
        "step": 1,
        "default": 10,
        "label": "Mínimo de avisos por barrio y operación"
      }
    },
    "question": "¿Dónde conviene más alquilar respecto del precio de compra?",
    "use": "Por barrio, con el dólar MEP actualizado."
  },
  "segments": {
    "label": "D · Segmentos de mercado",
    "desc": "K-means o HDBSCAN sobre variables estandarizadas; perfil de cada segmento y mapa PCA.",
    "params": {
      "operacion": {
        "type": "select",
        "options": [
          "venta",
          "alquiler"
        ],
        "default": "venta",
        "label": "Operación"
      },
      "method": {
        "type": "select",
        "options": [
          "kmeans",
          "hdbscan"
        ],
        "default": "kmeans",
        "label": "Método"
      },
      "k": {
        "type": "number",
        "min": 2,
        "max": 30,
        "step": 1,
        "default": 6,
        "label": "k (k-means)"
      },
      "min_cluster_size": {
        "type": "number",
        "min": 5,
        "max": 2000,
        "step": 5,
        "default": 40,
        "label": "min_cluster_size (HDBSCAN)"
      },
      "features": {
        "type": "multi",
        "options": [
          "usd_m2",
          "superficie",
          "ambientes",
          "banos",
          "cocheras",
          "antiguedad",
          "expensas_m2",
          "amenities_count",
          "fotos"
        ],
        "default": [
          "usd_m2",
          "superficie",
          "ambientes",
          "banos",
          "expensas_m2",
          "amenities_count"
        ],
        "label": "Variables"
      }
    },
    "question": "¿Qué tipos de propiedades hay?",
    "use": "Para estudiar submercados."
  },
  "text": {
    "label": "E · Variables de texto",
    "desc": "TF-IDF de la descripción: términos que suben/bajan el precio y cuánto mejora LightGBM al sumar el texto (SVD).",
    "params": {
      "operacion": {
        "type": "select",
        "options": [
          "venta",
          "alquiler"
        ],
        "default": "venta",
        "label": "Operación"
      },
      "tipo": {
        "type": "select",
        "options": [
          "todos",
          "departamento",
          "casa",
          "ph"
        ],
        "default": "departamento",
        "label": "Tipo"
      },
      "max_features": {
        "type": "number",
        "min": 500,
        "max": 50000,
        "step": 500,
        "default": 5000,
        "label": "Máx. términos"
      },
      "ngram_max": {
        "type": "number",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 2,
        "label": "n-gramas hasta"
      },
      "min_df": {
        "type": "number",
        "min": 1,
        "max": 100,
        "step": 1,
        "default": 5,
        "label": "min_df"
      },
      "svd_components": {
        "type": "number",
        "min": 5,
        "max": 300,
        "step": 5,
        "default": 50,
        "label": "Componentes SVD"
      },
      "test_size": {
        "type": "number",
        "min": 0.05,
        "max": 0.5,
        "step": 0.05,
        "default": 0.2,
        "label": "Proporción de test"
      },
      "split": {
        "type": "select",
        "options": [
          "aleatorio",
          "temporal"
        ],
        "default": "aleatorio",
        "label": "Separación train/test (temporal = test con los avisos más nuevos)"
      },
      "seed": {
        "type": "number",
        "min": 0,
        "max": 999999,
        "step": 1,
        "default": 42,
        "label": "Semilla aleatoria"
      }
    },
    "question": "¿Qué palabras del aviso mueven el precio?",
    "use": "Para ver señales en las descripciones."
  },
  "survival": {
    "label": "F · Tiempo hasta la baja (supervivencia)",
    "desc": "Kaplan-Meier por barrio y Cox. Necesita varias pasadas con historial de cambios y fichas dadas de baja; si no hay datos suficientes lo informa.",
    "params": {
      "operacion": {
        "type": "select",
        "options": [
          "venta",
          "alquiler"
        ],
        "default": "venta",
        "label": "Operación"
      },
      "min_events": {
        "type": "number",
        "min": 5,
        "max": 10000,
        "step": 5,
        "default": 30,
        "label": "Mínimo de bajas observadas"
      },
      "top_barrios": {
        "type": "number",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 6,
        "label": "Barrios en el gráfico"
      }
    },
    "question": "¿Cuánto tarda un aviso en desaparecer?",
    "use": "Requiere re-scrapes con seguimiento de cambios."
  }
}
